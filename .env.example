# OpenAI API Key (required for embeddings and streaming chat completions)
OPENAI_API_KEY=your_openai_api_key_here

# Redis Configuration (Message Queue for asynchronous document ingestion)
REDIS_HOST=redis
REDIS_PORT=6379

# Vector Database (Persistent directory for ChromaDB embeddings storage)
VECTOR_DB_PATH=/data/chroma

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
